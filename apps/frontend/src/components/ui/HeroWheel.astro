---
// HERO WHEEL — slowly turning Konark-style wheel used as a faint watermark in
// the hero sections. Sits in the top-left corner; from `lg` it drops to the
// base of the hero so it looks like it is rolling along the bottom line.
// The hero it is placed in must be `relative` and `overflow-hidden`.

// STYLES //
import "@/styles/common/page-hero.css";

const spokeAngles = Array.from({ length: 8 }, (_, i) => i * 45);
const beadAngles = Array.from({ length: 32 }, (_, i) => i * (360 / 32));
---

<svg
  class="page-hero-wheel pointer-events-none absolute -top-40 -left-40 size-[520px] text-orange-200 opacity-15 md:size-[680px] lg:top-auto lg:-bottom-2.5 lg:-left-52 lg:size-[900px]"
  aria-hidden="true"
  viewBox="0 0 200 200"
    fill="none"
    stroke="currentColor"
  >
    <circle cx="100" cy="100" r="96" stroke-width="3"></circle>
    <circle cx="100" cy="100" r="86" stroke-width="1.5"></circle>
    {
      beadAngles.map((angle) => (
        <circle
          cx="100"
          cy="9"
          r="2"
          fill="currentColor"
          stroke="none"
          transform={`rotate(${angle} 100 100)`}
        />
      ))
    }
    {
      spokeAngles.map((angle) => (
        <g transform={`rotate(${angle} 100 100)`}>
          <line x1="100" y1="116" x2="100" y2="14" stroke-width="5" />
          <circle cx="100" cy="52" r="8" stroke-width="2.5" />
          <circle cx="100" cy="52" r="2.5" fill="currentColor" stroke="none" />
        </g>
      ))
    }
    <circle cx="100" cy="100" r="18" stroke-width="3"></circle>
    <circle cx="100" cy="100" r="7" fill="currentColor" stroke="none"
    ></circle>
  </svg>
