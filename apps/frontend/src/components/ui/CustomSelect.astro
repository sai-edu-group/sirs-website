---
import CustomSelect from "@/components/ui/CustomSelect.astro";

interface Props {
  options: string[];
  label: string;
  name: string;
  placeholder: string;
  value?: string;
  required?: boolean;
}

const { options, label, name, placeholder, value, required = false } = Astro.props as Props;
---

<div class="relative">
  <label
    for={name}
    class="block text-n-500 font-xs md:font-base mb-1"
  >
    {label}
  </label>
  <select
    id={name}
    name={name}
    class="border-n-500 text-n-500 bg-n-50 placeholder-n-500 h-[50px] w-full rounded-lg border px-3 text-base font-medium focus:border-transparent focus:ring-2 focus:ring-orange-500 focus:outline-none appearance-none bg-no-repeat bg-right pr-10"
    required={required}
    value={value}
  >
    <option value="" disabled selected>
      {placeholder}
    </option>
    {options.map((option) => (
      <option value={option}>{option}</option>
    ))}
  </select>
  <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">
    <svg
      class="w-5 h-5 text-n-400"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</div>

<style>
  select {
    background-image: none;
  }
</style>