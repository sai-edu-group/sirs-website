---
import { generateImagePath } from "@/utils/image.utils";
import { IMAGE_TYPES } from "@/enums/image.enum";
import PhotoCard from "./PhotoCard.astro";

interface Props {
  photos?: string[];
  photo_path?: string;
}

const { photos = [], photo_path } = Astro.props as Props;
---

<div class="flex w-full flex-col gap-6">
  <p class="text-2xl font-bold lg:text-4xl">Photo Highlights</p>
  <!-- Photo Highlights Marquee - auto-scrolling horizontal gallery -->
  <div class="photo-marquee-container overflow-hidden">
    <div class="photo-marquee-track">
      {
        [...photos, ...photos].map((photoItem, albumsPhotosIndex) => (
          <div class="photo-marquee-item flex-shrink-0">
            <PhotoCard
              index={albumsPhotosIndex}
              image={generateImagePath(
                photoItem,
                IMAGE_TYPES.BLOG,
                photo_path,
              )}
              showExpandButton={false}
            />
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* Photo Highlights Marquee */
  .photo-marquee-container {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .photo-marquee-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: photo-marquee 40s linear infinite;
  }

  .photo-marquee-track:hover {
    animation-play-state: paused;
  }

  .photo-marquee-item {
    flex: 0 0 auto;
    width: 300px;
  }

  @media (min-width: 768px) {
    .photo-marquee-item {
      width: 350px;
    }
  }

  @media (min-width: 1024px) {
    .photo-marquee-item {
      width: 400px;
    }
  }

  @keyframes photo-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-marquee-track {
      animation: none;
    }
  }
</style>
