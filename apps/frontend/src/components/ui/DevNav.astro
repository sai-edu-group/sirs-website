---
// TEMPORARY DEV NAVIGATION — remove before production
const mainPages = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "SIRS Experience", href: "/sirs-experience" },
  { label: "Admissions", href: "/admissions" },
  { label: "Contact", href: "/contact-us" },
];

const consumptionPages = [
  { label: "Blogs Listing", href: "/media/blogs" },
  { label: "Blogs Listing (page)", href: "/media/blogs" },
  { label: "Albums Listing", href: "/media/albums" },
  { label: "Awards Listing", href: "/awards" },
  { label: "Facilities Detail", href: "/campus/hostel-life" },
  { label: "Global SAIoneers", href: "/sirs-experience/global-saIoneers" },
  { label: "Vision/Mission", href: "/about/vision-mission-values" },
  { label: "Admission Guidelines", href: "/admissions/guidelines" },
];

const current = Astro.url.pathname;
---

<div class="font-secondary fixed top-4 right-4 z-[999]">
  <details class="group">
    <summary
      class="cursor-pointer list-none rounded-lg bg-violet-700 px-4 py-2 text-sm font-semibold text-white"
    >
      🧭 Dev Nav
    </summary>

    <div
      class="border-n-200 absolute top-10 right-0 w-56 overflow-hidden rounded-xl border bg-white shadow-xl"
    >
      <!-- Main Pages -->
      <p
        class="bg-n-100 text-n-500 px-3 py-1.5 text-xs font-semibold tracking-wider uppercase"
      >
        Main Pages
      </p>
      {
        mainPages.map((page) => (
          <a
            href={page.href}
            class={`block px-3 py-2 text-sm transition hover:bg-orange-50 hover:text-orange-500 ${current === page.href ? "bg-orange-50 font-semibold text-orange-500" : "text-n-700"}`}
          >
            {page.label}
          </a>
        ))
      }

      <!-- Consumption Pages -->
      <p
        class="bg-n-100 text-n-500 border-n-200 border-t px-3 py-1.5 text-xs font-semibold tracking-wider uppercase"
      >
        Consumption Pages
      </p>
      {
        consumptionPages.map((page) => (
          <a
            href={page.href}
            class={`block px-3 py-2 text-sm transition hover:bg-orange-50 hover:text-orange-500 ${current === page.href ? "bg-orange-50 font-semibold text-orange-500" : "text-n-700"}`}
          >
            {page.label}
          </a>
        ))
      }
    </div>
  </details>
</div>
