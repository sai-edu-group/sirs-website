---
const pillars = [
  {
    title: "Smart classrooms",
    text: "Interactive panels and curated digital content in every teaching space, so a diagram can move and a concept can be tested live.",
  },
  {
    title: "Coding & robotics",
    text: "Computational thinking from the primary years, growing into robotics, AI literacy and project-based builds in middle and senior school.",
  },
  {
    title: "Digital portfolios",
    text: "Every child's work, projects and progress collected in one place — visible to teachers, and to parents, without waiting for a report card.",
  },
  {
    title: "Parent portal",
    text: "Attendance, assessments, circulars and boarding updates in one login, so families stay close even when they are far away.",
  },
];
---

<section
  id="digital"
  class="bg-n-100 relative overflow-hidden"
  data-section="SIRS Digital"
>
  <div class="container mx-auto px-6 py-16 md:py-20 lg:py-24 2xl:px-0">
    <div
      class="grid gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-center lg:gap-16"
    >
      <!-- Copy -->
      <div class="space-y-8">
        <div class="space-y-3">
          <p
            class="font-secondary flex items-center gap-3 text-xs font-semibold tracking-[0.25em] text-orange-500 uppercase md:text-sm"
          >
            <span class="size-1.5 rotate-45 bg-orange-500" aria-hidden="true"
            ></span>
            Digital
          </p>
          <h2
            class="text-n-800 text-4xl leading-[1.1] font-medium md:text-5xl lg:text-6xl"
          >
            A campus that thinks in code.
          </h2>
          <p
            class="font-secondary text-n-600 text-base leading-relaxed md:text-lg"
          >
            Technology at SIRS is not a separate subject or a showpiece lab. It
            is the whiteboard, the notebook, the noticeboard and the workshop —
            quietly present in the way every subject is taught.
          </p>
        </div>

        <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {
            pillars.map((pillar, index) => (
              <article
                class="card-anim card-bottom"
                style={`--delay: ${index * 0.06}s`}
              >
                <span class="bg-n-800 mb-3 flex size-8 items-center justify-center rounded-lg text-xs font-semibold text-white">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="text-n-800 text-lg font-medium">{pillar.title}</h3>
                <p class="font-secondary text-n-600 mt-1.5 text-sm leading-relaxed">
                  {pillar.text}
                </p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Device mockup -->
      <div class="relative">
        <div
          aria-hidden="true"
          class="absolute -top-6 -right-6 size-40 rounded-full bg-orange-200/50 blur-2xl"
        >
        </div>

        <div
          class="border-n-800/10 bg-n-950 relative overflow-hidden rounded-[28px] border shadow-2xl"
        >
          <!-- Top bar -->
          <div
            class="flex items-center gap-2 border-b border-white/10 px-5 py-4"
          >
            <span class="size-2.5 rounded-full bg-orange-400"></span>
            <span class="size-2.5 rounded-full bg-white/20"></span>
            <span class="size-2.5 rounded-full bg-white/20"></span>
            <span
              class="font-secondary ml-auto text-[10px] font-semibold tracking-[0.18em] text-white/40 uppercase"
            >
              SAI Digital · Today
            </span>
          </div>

          <div class="grid gap-4 p-5 sm:grid-cols-[1.15fr_0.85fr] md:p-6">
            <!-- Timetable -->
            <div class="space-y-2.5">
              <p
                class="font-secondary text-[10px] font-semibold tracking-[0.18em] text-white/40 uppercase"
              >
                Grade VIII · Wednesday
              </p>
              {
                [
                  ["08:00", "Mathematics", "Room 204"],
                  ["09:00", "Physics lab", "Block C"],
                  ["10:30", "English", "Room 118"],
                  ["11:30", "Robotics", "Maker space"],
                  ["14:00", "Football", "North field"],
                ].map(([time, subject, room], index) => (
                  <div
                    class:list={[
                      "flex items-center gap-3 rounded-xl px-3 py-2.5",
                      index === 1
                        ? "bg-orange-500 text-white"
                        : "bg-white/[0.06] text-white/80",
                    ]}
                  >
                    <span
                      class:list={[
                        "font-secondary text-[10px] font-semibold",
                        index === 1 ? "text-white/80" : "text-white/40",
                      ]}
                    >
                      {time}
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-sm font-medium">{subject}</p>
                      <p
                        class:list={[
                          "font-secondary text-[10px]",
                          index === 1 ? "text-white/70" : "text-white/35",
                        ]}
                      >
                        {room}
                      </p>
                    </div>
                    {index === 1 && (
                      <span class="size-2 shrink-0 rounded-full bg-white" />
                    )}
                  </div>
                ))
              }
            </div>

            <!-- Progress -->
            <div class="flex flex-col gap-4">
              <div
                class="rounded-2xl border border-white/10 bg-white/[0.04] p-4"
              >
                <p
                  class="font-secondary text-[10px] font-semibold tracking-[0.18em] text-white/40 uppercase"
                >
                  Term progress
                </p>
                <div class="mt-3 space-y-3">
                  {
                    [
                      ["Mathematics", 86],
                      ["Sciences", 78],
                      ["English", 91],
                    ].map(([label, value]) => (
                      <div>
                        <div class="flex items-center justify-between text-[11px] text-white/70">
                          <span>{label}</span>
                          <span class="font-secondary font-semibold">
                            {value}%
                          </span>
                        </div>
                        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-white/10">
                          <div
                            class="h-full rounded-full bg-orange-400"
                            style={`width: ${value}%`}
                            aria-hidden="true"
                          />
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>

              <div
                class="rounded-2xl border border-white/10 bg-white/[0.04] p-4"
              >
                <p
                  class="font-secondary text-[10px] font-semibold tracking-[0.18em] text-white/40 uppercase"
                >
                  Teacher note
                </p>
                <p class="mt-2 text-xs leading-relaxed text-white/70">
                  “Excellent improvement in the mechanics unit. Next: try the
                  extension problem set.”
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating chips -->
        <div
          class="font-secondary absolute -bottom-5 -left-2 rounded-xl bg-orange-500 px-4 py-2.5 text-[11px] font-semibold text-white shadow-lg sm:-left-5 md:px-5 md:py-3 md:text-sm"
        >
          Robotics &amp; AI lab
        </div>
        <div
          class="font-secondary text-n-800 absolute -top-5 right-8 hidden rounded-xl bg-white px-4 py-2.5 text-[11px] font-semibold shadow-lg sm:block md:text-sm"
        >
          Live parent updates
        </div>
      </div>
    </div>
  </div>
</section>
