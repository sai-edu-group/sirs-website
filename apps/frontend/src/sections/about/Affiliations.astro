---
// COMPONENTS //
import ArticleCard from "@/components/ui/ArticleCard.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";

// DATA //
import { affiliationsDetails } from "@/data/about/affiliations";
import { affiliationsGuide } from "@/data/about/affiliations-seo-content";

/** Board copy shown inside each affiliation card, keyed by card title */
const boardCopy = {
  CBSE: affiliationsGuide.cbse,
  IGCSE: affiliationsGuide.caie,
} as const;

const breadcrumbItems = [
  { label: "About", href: "/about" },
  { label: "Affiliations" },
];
---

<section class="bg-n-100 relative w-full overflow-hidden">
  <div
    class="container mx-auto flex flex-col gap-10 px-5 pt-32 pb-14 md:gap-14 md:px-8 md:pt-40 md:pb-20 lg:gap-20 lg:pt-40 lg:pb-24"
  >
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbItems} />
    <!-- Section header title and intro -->
    <div class="space-y-4">
      <div class="space-y-2.5">
        <p
          class="animatedText text-n-600 text-sm font-normal md:text-base lg:text-xl"
        >
          Our Affiliations
        </p>
        <div class="relative flex flex-col gap-2.5 md:gap-1.5 lg:gap-4">
          <h1
            class="animatedText text-n-800 text-4xl leading-[112%] font-medium md:text-5xl lg:leading-tight"
          >
            {affiliationsGuide.h1}
          </h1>
          <p
            class="animatedText font-secondary text-n-600 text-base leading-normal font-medium md:text-xl lg:text-2xl"
          >
            {affiliationsDetails.sectionHeaderContent.subtitle}
          </p>
        </div>
      </div>

      <p
        class="text-n-600 font-secondary max-w-4xl text-base leading-relaxed md:text-lg"
      >
        {affiliationsGuide.intro}
      </p>
    </div>

    <!-- Affiliations Cards wrapper -->
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:gap-8">
      <!-- Affiliations Cards -->
      {
        affiliationsDetails.affiliationsContent.map(
          (affiliationsContentItem, cardIndex) => {
            const board =
              boardCopy[affiliationsContentItem.title as keyof typeof boardCopy];
            return (
              <div
                class="card-anim card-bottom"
                style={`--delay: ${cardIndex * 0.1}s`}
              >
                <ArticleCard
                  title={board?.heading ?? affiliationsContentItem.title}
                  img={affiliationsContentItem.img}
                  href={`/about/affiliations/${affiliationsContentItem.title.toLowerCase()}`}
                  description={
                    board ? board.paragraphs.join(" ") : affiliationsContentItem.description
                  }
                  badgeText=""
                  objectFit="contain"
                />
              </div>
            );
          },
        )
      }
    </div>
  </div>
</section>
