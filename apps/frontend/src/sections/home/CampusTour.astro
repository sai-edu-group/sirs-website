---
/* Figma 04a — Campus Tour (node 6971:30587)
   Illustrated isometric map + tilted distance pills + centre badge +
   red "Hear What We Hear" pill + overlapping white content card. */

const YOUTUBE_VIDEO_ID = "xKe6hNtTYv0";
---

<section data-section="Home Campus Tour">
  <div class="container mx-auto px-6 py-12 md:py-16 lg:py-20 2xl:px-0">
    <!-- Map wrapper -->
    <div class="relative">
      <div
        class="relative overflow-hidden rounded-3xl md:rounded-[32px] lg:mx-auto lg:w-[80%]"
        data-campus-media
      >
        <img
          src="/images/campus-map.png"
          alt="Illustrated map of the 49-acre SAI Residential campus"
          class="aspect-video w-full object-cover object-center transition-opacity duration-700 ease-out"
          loading="lazy"
          decoding="async"
          data-campus-image
        />

        <!-- YouTube player, preloaded and hidden so playback starts with
             no visible loading — the click only triggers a fade + play. -->
        <div
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-700 ease-out"
          data-campus-video-wrap
        >
          <iframe
            class="h-full w-full"
            src={`https://www.youtube.com/embed/${YOUTUBE_VIDEO_ID}?enablejsapi=1&playsinline=1&rel=0&cc_load_policy=0&controls=0&modestbranding=1&iv_load_policy=3&disablekb=1`}
            title="Campus tour video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            data-campus-video
          ></iframe>
        </div>

        <!-- Distance pills, top-left, tilted + stacked — hidden on mobile -->
        <div
          class="absolute top-5 -left-2 hidden -rotate-3 flex-col items-start gap-1.5 md:top-8 md:-left-4 md:flex md:gap-2"
        >
          <span
            class="font-secondary bg-orange-500 -rotate-2 rounded-md px-4 py-2 text-sm font-medium text-white shadow-lg md:px-6 md:text-base"
          >
            23km from Bhubaneswar
          </span>
          <span
            class="font-secondary bg-n-900 ml-4 -rotate-2 rounded-md px-4 py-2 text-sm font-medium text-white shadow-lg md:ml-6 md:px-6 md:text-base"
          >
            30km from the Airport
          </span>
          <span
            class="font-secondary bg-violet-800 ml-2 -rotate-2 rounded-md px-4 py-2 text-sm font-medium text-white shadow-lg md:ml-3 md:px-6 md:text-base"
          >
            15km from Cuttack
          </span>
        </div>

        <!-- Centre play button -->
        <button
          type="button"
          class="bg-orange-500 hover:bg-orange-600 absolute top-1/2 left-1/2 flex size-20 -translate-x-1/2 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full shadow-xl transition duration-300 ease-out md:size-24"
          aria-label="Play campus tour video"
          data-campus-play
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="white"
            class="size-8 translate-x-0.5 md:size-9"
            aria-hidden="true"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </button>

        <!-- Hear pill, top-right -->
        <button
          type="button"
          class="bg-orange-500 absolute top-5 right-4 flex items-center gap-2 rounded-full p-3 text-sm font-semibold text-white shadow-xl transition hover:brightness-110 sm:px-5 sm:py-3 md:top-8 md:right-8 md:text-base"
          aria-label="Hear what we hear"
          data-campus-audio
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-4 md:size-5"
            aria-hidden="true"
            data-campus-audio-icon-muted
          >
            <path d="M3 9v6h4l5 5V4L7 9H3z"></path>
            <path
              d="M16 9l5.5 5.5M21.5 9 16 14.5"
              stroke="currentColor"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"></path>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="hidden size-4 md:size-5"
            aria-hidden="true"
            data-campus-audio-icon-unmuted
          >
            <path d="M3 9v6h4l5 5V4L7 9H3z"></path>
            <path
              d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"
              stroke="currentColor"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"></path>
          </svg>
          <span class="hidden sm:inline">Hear What We Hear</span>
        </button>

        <audio src="/audio/campus-sound.wav" preload="auto" data-campus-audio-el></audio>
      </div>
    </div>

    <!-- Overlapping white card, bottom-left -->
    <div class="relative z-10 px-2 md:px-8 lg:px-0">
      <div
        class="-mt-8 w-full rounded-3xl bg-white p-6 shadow-[0_20px_60px] shadow-n-900/12 transition-[margin-top] duration-700 ease-out lg:-mt-24 lg:w-[46%] lg:p-9"
        data-campus-card
      >
        <h2
          class="text-orange-500 text-3xl leading-tight font-medium md:text-[2.75rem]"
        >
          49 Acres of Everything
        </h2>
        <p class="font-secondary text-n-600 mt-4 leading-relaxed font-normal md:text-lg">
          Between Bhubaneswar and Cuttack, our green campus unfolds across
          playing fields, a boating lake and quiet garden paths. Forest gives
          way to stadium, stadium to hostel courtyard, each corner built for a
          different kind of childhood. It&rsquo;s a big place to grow up in,
          and every acre of it is built for exactly that.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  function initCampusTour(section: Element) {
    const playBtn = section.querySelector<HTMLButtonElement>("[data-campus-play]");
    const image = section.querySelector<HTMLImageElement>("[data-campus-image]");
    const videoWrap = section.querySelector<HTMLElement>("[data-campus-video-wrap]");
    const video = section.querySelector<HTMLIFrameElement>("[data-campus-video]");
    const audioBtn = section.querySelector<HTMLButtonElement>("[data-campus-audio]");
    const audioEl = section.querySelector<HTMLAudioElement>("[data-campus-audio-el]");
    const mutedIcon = section.querySelector<HTMLElement>("[data-campus-audio-icon-muted]");
    const unmutedIcon = section.querySelector<HTMLElement>("[data-campus-audio-icon-unmuted]");
    const card = section.querySelector<HTMLElement>("[data-campus-card]");

    playBtn?.addEventListener(
      "click",
      () => {
        videoWrap?.classList.remove("opacity-0", "pointer-events-none");
        videoWrap?.classList.add("opacity-100", "pointer-events-auto");
        image?.classList.add("opacity-0");
        playBtn.classList.add("opacity-0", "pointer-events-none");
        audioBtn?.classList.add("opacity-0", "pointer-events-none");
        // Slide the card clear of the video on mobile/tablet, where it
        // rests with a slight overlap. Set as an inline style (not a
        // Tailwind class) since the class only exists in this script, not
        // in any scanned markup, so Tailwind never generates its CSS.
        // Guarded to <lg so it doesn't fight the lg: overlap on desktop.
        if (card && !window.matchMedia("(min-width: 1024px)").matches) {
          card.style.marginTop = "2rem";
        }

        video?.contentWindow?.postMessage(
          JSON.stringify({ event: "command", func: "playVideo", args: [] }),
          "https://www.youtube.com",
        );
        // cc_load_policy=0 on the embed URL isn't always enough to keep
        // captions off, so also force them off via the player API once
        // it's ready to receive commands.
        video?.contentWindow?.postMessage(
          JSON.stringify({ event: "command", func: "unloadModule", args: ["captions"] }),
          "https://www.youtube.com",
        );
      },
      { once: true },
    );

    audioBtn?.addEventListener("click", () => {
      if (!audioEl) return;
      if (audioEl.paused) {
        audioEl.play().catch(() => {});
      } else {
        audioEl.pause();
      }
    });

    audioEl?.addEventListener("play", () => {
      mutedIcon?.classList.add("hidden");
      unmutedIcon?.classList.remove("hidden");
    });

    audioEl?.addEventListener("pause", () => {
      mutedIcon?.classList.remove("hidden");
      unmutedIcon?.classList.add("hidden");
    });
  }

  document
    .querySelectorAll('[data-section="Home Campus Tour"]')
    .forEach((section) => initCampusTour(section));
</script>
