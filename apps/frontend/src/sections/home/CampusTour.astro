---
/* Figma 04a — Campus Tour (node 6971:30587)
   Illustrated isometric map + tilted distance pills + centre badge +
   red "Hear What We Hear" pill + overlapping white content card. */
---

<section data-section="Home Campus Tour">
  <div class="container mx-auto px-6 py-12 md:py-16 lg:py-20 2xl:px-0">
    <!-- Map wrapper -->
    <div class="relative">
      <div
        class="overflow-hidden rounded-[24px] bg-[#c3cf8a] md:rounded-[32px]"
      >
        <img
          src="/images/campus-map.png"
          alt="Illustrated map of the 49-acre SAI Residential campus"
          class="h-[420px] w-full object-cover object-center md:h-[560px] lg:h-[640px]"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Distance pills, top-left, tilted + stacked -->
      <div
        class="absolute top-5 -left-2 flex -rotate-3 flex-col items-start gap-1.5 md:top-8 md:-left-4 md:gap-2"
      >
        <span
          class="font-secondary -rotate-2 rounded-md bg-[#c8514b] px-4 py-2 text-sm font-medium text-white shadow-lg md:px-6 md:text-base"
        >
          XX km to Bhubaneswar
        </span>
        <span
          class="font-secondary ml-4 -rotate-2 rounded-md bg-[#101f36] px-4 py-2 text-sm font-medium text-white shadow-lg md:ml-6 md:px-6 md:text-base"
        >
          XX km to the Airport
        </span>
        <span
          class="font-secondary ml-2 -rotate-2 rounded-md bg-[#3a2344] px-4 py-2 text-sm font-medium text-white shadow-lg md:ml-3 md:px-6 md:text-base"
        >
          XX km to Cuttack
        </span>
      </div>

      <!-- Centre badge -->
      <div
        class="absolute top-1/2 left-1/2 flex size-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-[#0a3d2c] shadow-xl md:size-24"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="white"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-9 md:size-10"
        >
          <circle cx="12" cy="9" r="5"></circle>
          <path d="M12 6.5 13.2 8l1.8.3-1.3 1.3.3 1.9-1.9-1-1.9 1 .4-1.9-1.4-1.3 1.8-.3z"></path>
          <path d="M9.5 13.5 8 21l2-1 2 1 2-1 2 1-1.5-7.5"></path>
          <path d="M9.5 13.5h5"></path>
        </svg>
      </div>

      <!-- Hear pill, bottom-right -->
      <button
        type="button"
        class="absolute right-4 bottom-16 flex items-center gap-2 rounded-full bg-[#d3544a] px-5 py-3 text-sm font-semibold text-white shadow-xl transition hover:brightness-110 md:right-8 md:bottom-20 md:text-base"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-4 md:size-5"
          aria-hidden="true"
        >
          <path
            d="M3 9v6h4l5 5V4L7 9H3z"></path>
          <path
            d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"></path>
        </svg>
        Hear What We Hear
      </button>
    </div>

    <!-- Overlapping white card, bottom-left -->
    <div class="relative z-10 px-2 md:px-8">
      <div
        class="font-secondary -mt-14 max-w-2xl rounded-[24px] bg-white p-6 shadow-[0_20px_60px_rgba(16,31,54,0.12)] md:-mt-24 md:p-10"
      >
        <h2
          class="text-3xl leading-tight font-medium text-[#c8514b] md:text-[2.75rem]"
        >
          49 Acres of Everything
        </h2>
        <p class="mt-4 leading-relaxed font-normal text-slate-600 md:text-lg">
          Between Bhubaneswar and Cuttack, our green campus unfolds across
          playing fields, a boating lake and quiet garden paths. Forest gives
          way to stadium, stadium to hostel courtyard, each corner built for a
          different kind of childhood. It&rsquo;s a big place to grow up in,
          and every acre of it is built for exactly that.
        </p>
      </div>
    </div>
  </div>
</section>
