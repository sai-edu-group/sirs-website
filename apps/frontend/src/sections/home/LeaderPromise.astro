---

---

<section data-section="Home Leader Promise" class="bg-white">
  <div class="py-12 md:py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:max-h-[80vh] lg:grid-cols-2">
      <!-- Photo left -->
      <div
        class="bg-n-100 relative min-h-[320px] md:min-h-[440px] lg:min-h-[70vh]"
      >
        <img
          src="/images/leader.webp"
          alt="Dr. Silpi Sahoo with SIRS students"
          class="absolute inset-0 h-full w-full object-cover object-top"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Quote right -->
      <div class="bg-n-100 flex items-center justify-start p-8 md:p-12 lg:p-16">
        <div class="flex flex-col items-start gap-5 md:gap-6 lg:max-w-xl">
          <blockquote
            class="text-n-800 text-2xl leading-snug font-medium italic md:text-[1.9rem] md:leading-[1.35]"
          >
            &ldquo;Parents don&rsquo;t hand us marksheets to improve. They hand
            us their children. That is a promise we keep every single day and
            night.&rdquo;
          </blockquote>
          <div class="mt-2 lg:mt-4">
            <p class="text-xl font-semibold text-orange-500">Dr. Silpi Sahoo</p>
            <p
              class="font-secondary text-n-500 mt-1 max-w-md text-sm leading-relaxed"
            >
              Chairperson, SAI International Education Group, carrying forward
              the legacy of Founder Dr. Bijaya Kumar Sahoo
            </p>
          </div>
          <a
            href="/about/leadership"
            class="font-secondary inline-flex items-center gap-2 rounded-xl bg-orange-50 px-5 py-2.5 text-sm font-semibold text-orange-600 transition hover:brightness-95"
          >
            Her Message to Parents
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
