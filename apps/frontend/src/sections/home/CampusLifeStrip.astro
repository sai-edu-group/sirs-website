---
// COMPONENTS //
import SliderArrowButton from "@/components/ui/SliderArrowButton.astro";


// Slider Photos
const photos = [
  { src: "/images/strip-stadium.png", alt: "Stadium and turf" },
  { src: "/images/strip-horse.png", alt: "Horse riding" },
  { src: "/images/strip-gym.png", alt: "Outdoor gym" },
  { src: "/images/strip-chairperson.png", alt: "Students with the Chairperson" },
  { src: "/images/strip-cafeteria.png", alt: "Cafeteria" },
];
---

<section data-section="Home Campus Life Strip">
  <div class="flex flex-col gap-6 py-12 md:py-16 lg:py-20">
    <div
      id="campus-life-strip"
      data-strip-viewport
      class="flex gap-4 overflow-x-auto px-6 [scrollbar-width:none] md:gap-6 [&::-webkit-scrollbar]:hidden"
    >
      {
        photos.map((photo) => (
          <figure class="relative aspect-[4/3] w-[82%] shrink-0 overflow-hidden rounded-2xl bg-n-100 md:w-[42%] lg:w-[31%]">
            <img
              src={photo.src}
              alt={photo.alt}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </div>

    <div class="flex justify-end gap-3 px-6">
      <SliderArrowButton direction="prev" data-strip-prev />
      <SliderArrowButton direction="next" data-strip-next />
    </div>
  </div>
</section>

<script>
  import "@/scripts/home/campus-life-strip";
</script>
