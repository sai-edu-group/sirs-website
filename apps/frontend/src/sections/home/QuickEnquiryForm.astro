---
// COMPONENTS //
import CustomSelect from "@/components/ui/CustomSelect.astro";
import Button from "@/components/ui/Button.astro";

const gradeOptions = ["Class IV", "Class V", "Class VI", "Class VII", "Class VIII", "Class IX", "Class XI"];

const inputClass =
  "font-secondary bg-n-100 text-n-800 placeholder:text-n-500 h-[50px] w-full rounded-2xl px-4 text-sm focus:outline-none";
const errorClass =
  "font-secondary pointer-events-none absolute top-full left-1 mt-0.5 hidden text-[11px] leading-none text-red-600";
---

<div class="relative z-[100] mx-auto mt-8 max-w-[1480px] px-6 lg:mt-0 lg:-translate-y-[65%]" data-quick-enquiry-wrap>
  <form
    class="border-orange-200 relative flex w-full flex-col items-stretch gap-6 rounded-[28px] border bg-white p-5 shadow-xl md:mx-auto md:w-fit lg:mx-0"
    data-quick-enquiry-form
    novalidate
  >
    <div>
      <p class="font-secondary text-orange-500 text-[11.5px] font-semibold tracking-wide uppercase">
        Quick Enquiry
      </p>
      <p class="font-secondary text-n-800 mt-1 text-[15.5px] leading-snug font-medium">
        Fill the form and our counsellors will reach out to you.
      </p>
    </div>

    <div class="grid w-full grid-cols-2 gap-x-2.5 gap-y-4 md:w-[520px]">
      <!-- Student name -->
      <div class="relative">
        <input
          type="text"
          name="studentName"
          required
          placeholder="Student's Name"
          autocomplete="off"
          class={inputClass}
          data-field-input
        />
        <p class={errorClass} data-error="studentName"></p>
      </div>

      <!-- Grade -->
      <div class="relative">
        <CustomSelect label="Grade" name="grade" placeholder="Grade" options={gradeOptions} />
        <p class={errorClass} data-error="grade"></p>
      </div>

      <!-- Phone -->
      <div class="relative">
        <input
          type="tel"
          name="phone"
          required
          placeholder="Phone Number"
          inputmode="numeric"
          maxlength="10"
          autocomplete="tel"
          class={inputClass}
          data-field-input
        />
        <p class={errorClass} data-error="phone"></p>
      </div>

      <Button text="Send" type="submit" mode="block" data-quick-enquiry-submit />
    </div>

    <!-- Success state: sits over the form so the card never changes height -->
    <div
      class="absolute inset-0 hidden flex-col items-center justify-center gap-2 rounded-[28px] bg-white px-6 text-center"
      role="status"
      data-quick-enquiry-success
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-10 text-orange-500"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="m8 12.5 2.8 2.8L16 9.5"></path>
      </svg>
      <p class="text-n-800 text-xl font-medium">Thank you!</p>
      <p class="font-secondary text-n-600 text-sm">
        Our counsellors will reach out to you shortly.
      </p>
    </div>
  </form>
</div>

<script>
  import "@/scripts/home/quick-enquiry-form";
</script>
