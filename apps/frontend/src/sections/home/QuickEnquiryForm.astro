---
// ============================================================
// QUICK ENQUIRY FORM — compact 2-column strip that sits exactly
// half on the Hero, half off it: the wrapper is placed in normal
// flow right after <Hero /> and pulled up by translateY(-50%),
// which is always exactly half of its own rendered height no
// matter how the fields reflow at each breakpoint.
//
// It also reports its own height back to <Hero /> via the
// --qe-form-half CSS variable, which Hero's min-height reads
// (screen height - form height / 2) so the whole card is always
// visible in the first viewport.
// ============================================================
import CustomSelect from "@/components/ui/CustomSelect.astro";
import Button from "@/components/ui/Button.astro";

const gradeOptions = ["Class IV", "Class V", "Class VI", "Class VII", "Class VIII", "Class IX", "Class XI"];
---

<div class="relative z-[100] mx-auto mt-8 max-w-[1480px] px-6 lg:mt-0 lg:-translate-y-[65%]" data-quick-enquiry-wrap>
  <form
    class="border-orange-200 flex w-full flex-col items-stretch gap-6 rounded-[28px] border bg-white p-5 shadow-xl md:mx-auto md:w-fit lg:mx-0"
    data-quick-enquiry-form
  >
    <div>
      <p class="font-secondary text-orange-500 text-[11.5px] font-semibold tracking-wide uppercase">
        Quick Enquiry
      </p>
      <p class="font-secondary text-n-800 mt-1 text-[15.5px] leading-snug font-medium">
        Fill the form and our counsellors will reach out to you.
      </p>
    </div>

    <div class="grid w-full grid-cols-2 gap-2.5 md:w-[520px]">
      <input
        type="text"
        name="studentName"
        required
        placeholder="Student's Name"
        class="font-secondary bg-n-100 text-n-800 placeholder:text-n-500 h-[50px] w-full rounded-2xl px-4 text-sm focus:outline-none"
      />

      <CustomSelect label="Grade" name="grade" placeholder="Grade" options={gradeOptions} />

      <input
        type="tel"
        name="phone"
        required
        placeholder="Phone Number"
        class="font-secondary bg-n-100 text-n-800 placeholder:text-n-500 h-[50px] w-full rounded-2xl px-4 text-sm focus:outline-none"
      />

      <Button text="Send" type="submit" mode="block" />
    </div>
  </form>
</div>

<script>
  function reportFormHeight() {
    const form = document.querySelector<HTMLElement>("[data-quick-enquiry-form]");
    if (!form) return;
    const half = form.offsetHeight / 2;
    document.documentElement.style.setProperty("--qe-form-half", `${half}px`);
  }

  function boot() {
    reportFormHeight();

    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(reportFormHeight, 150);
    });

    // Fonts/webfonts loading late can shift the form's height slightly.
    if ("fonts" in document) {
      (document as any).fonts.ready.then(reportFormHeight).catch(() => {});
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>
