---
import CustomSelect from "@/components/ui/CustomSelect.astro";

// DATA //
import { eyebrowText, heroSlides } from "@/data/home/hero";

const grades = [
  "Play Group",
  "Nursery",
  "KG I",
  "KG II",
  "Class I",
  "Class II",
  "Class III",
  "Class IV",
  "Class V",
  "Class VI",
  "Class VII",
  "Class VIII",
  "Class IX",
  "Class XI - Science",
  "Class XI - Commerce",
  "Class XI - Humanities",
  "Class XI - Cambridge (A Level)",
];

const INTERVAL = 5000;
---

<section
  class="bg-orange-500 relative flex items-center overflow-hidden pt-[140px] pb-12 lg:min-h-(--hero-h) lg:pt-(--hero-top) lg:pb-8 lg:[--hero-top:132px] lg:[--hero-h:max(42rem,calc(100vh-var(--qe-form-half,90px)))]"
  data-hero
  data-interval={INTERVAL}
>
  <img
    src="/images/vectors/mini-rath.png"
    alt=""
    aria-hidden="true"
    class="mini-rath-drift pointer-events-none absolute right-6 bottom-0 z-50 w-[90px] max-w-none opacity-100 select-none sm:w-[140px]"
    width="220"
    height="180"
    loading="lazy"
  />

  <div
    class="relative z-10 mx-auto grid w-full max-w-[1480px] grid-cols-1 items-center gap-8 px-4 md:px-6 lg:grid-cols-[0.90fr_2.6fr] lg:gap-0"
  >
    <!-- Left Column: Hero Text & Dots -->
    <div class="relative z-20 order-2 lg:order-1 lg:min-w-0 lg:self-start" data-hero-textcol>
      <p class="font-secondary mb-4 text-lg text-white/75 italic md:text-xl">
        {eyebrowText}
      </p>

      <h1
        data-hero-headline
        data-slides={JSON.stringify(heroSlides.map((slide) => slide.headline))}
        class="max-w-xl text-[34px] leading-[1.15] font-bold text-white transition-all duration-500 ease-out md:text-[48px] lg:max-w-none lg:w-[600px] lg:text-[52px] xl:w-[660px] xl:text-[60px]"
      >
        {heroSlides[0].headline}
      </h1>

      <div class="mt-10 flex items-center gap-2" data-hero-dots>
        {
          heroSlides.map((slide, slideIndex) => (
            <button
              type="button"
              class="hero-dot h-1.5 w-9 cursor-pointer rounded-full transition-colors duration-500 ease-out"
              class:list={[slideIndex === 0 ? "bg-white" : "bg-white/35"]}
              data-dot-index={slideIndex}
              aria-label={`Show headline ${slideIndex + 1}`}
              aria-current={slideIndex === 0 ? "true" : "false"}
            />
          ))
        }
      </div>
    </div>

    <!-- Right Column: Video Stage + Quick Enquiry Form Card -->
    <div class="relative z-10 order-1 lg:order-2 lg:-ml-8 lg:grid lg:grid-cols-1 lg:gap-0 lg:grid-rows-[auto_1fr]">
      <div
        class="hero-video-stage relative aspect-[16/10] max-h-[calc(100svh-140px-3rem)] min-h-56 w-full overflow-hidden rounded-[28px] shadow-2xl lg:aspect-auto lg:h-[calc(var(--hero-h)-var(--hero-top)-2rem)] lg:max-h-none"
        data-hero-video-stage
      >
        {
          heroSlides.map((slide, slideIndex) => (
            <video
              class="hero-video absolute inset-0 h-full w-full object-cover"
              data-hero-video
              poster={slideIndex === 0 ? "/images/activities.jpg" : undefined}
              autoplay={slideIndex === 0}
              muted
              loop
              playsinline
              preload={slideIndex === 0 ? "auto" : "none"}
            >
              <source
                data-src={slide.video}
                type="video/mp4"
                src={slideIndex === 0 ? slide.video : undefined}
              />
            </video>
          ))
        }
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/60 via-black/15 to-transparent"
        >
        </div>
      </div>

      <!-- Quick Enquiry Form Card (Right Side) -->
      <div class="relative z-20 lg:absolute lg:bottom-0 lg:left-full lg:ml-4 lg:w-[55%] lg:max-w-[55%] xl:max-w-[55%] lg:ml-6">
        <div class="fade-in-up rounded-lg border border-n-100 bg-white p-4 md:px-6 md:py-5 lg:w-full xl:max-w-[55%]">
          <div class="space-y-3.5">
            <h2 class="text-n-800 text-xl md:text-2xl">
              Get the SAI Experience in Your Hands
            </h2>

            <form
              class="flex flex-col gap-3.5 md:flex-row md:flex-wrap md:justify-between"
              data-hero-form
              novalidate
            >
              <!-- Student Name Input -->
              <div class="space-y-1 md:w-[58%]">
                <input
                  type="text"
                  name="studentName"
                  placeholder="Student's Name"
                  class="border-n-500 text-n-500 placeholder-n-500 h-[50px] w-full rounded-lg border px-3 text-base font-medium focus:border-transparent focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  required
                />
                <p
                  id="studentName-error"
                  data-error
                  class="hidden text-sm text-red-600"
                >
                  Please enter the student name.
                </p>
                <p
                  id="studentName-number-error"
                  data-error
                  class="hidden text-sm text-red-600"
                >
                  Name cannot contain numbers.
                </p>
              </div>

              <!-- Grade Select -->
              <div class="md:w-[39%]">
                <CustomSelect
                  options={grades}
                  label="Select Grade"
                  name="grade"
                  placeholder="Select Grade"
                />
                <p
                  id="grade-error"
                  data-error
                  class="hidden text-sm text-red-600"
                >
                  Please select a grade.
                </p>
              </div>

              <!-- Phone Number Input -->
              <div class="space-y-1 md:w-[58%]">
                <input
                  type="tel"
                  name="phone"
                  placeholder="Phone Number"
                  class="border-n-500 text-n-500 placeholder-n-500 h-[50px] w-full rounded-lg border px-3 text-base font-medium focus:border-transparent focus:ring-2 focus:ring-orange-500 focus:outline-none"
                  required
                />
                <p
                  id="phone-error"
                  data-error
                  class="hidden text-sm text-red-600"
                >
                  Please enter a valid 10-digit phone number.
                </p>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                class="fade-in font-secondary h-[50px] w-full cursor-pointer rounded-lg border border-transparent bg-orange-500 text-lg text-orange-50 transition-all duration-300 hover:border-orange-500 hover:bg-transparent hover:text-orange-500 focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 focus:outline-none md:w-[39%]"
              >
                Get Brochure
              </button>

              <div
                id="hero-loader"
                class="mt-2 flex hidden w-full items-center gap-3 text-orange-600 md:w-[39%]"
              >
                <div class="spinner"></div>
                <span class="text-base font-medium">Submitting...</span>
              </div>

              <!-- Success Message -->
              <p
                id="hero-success"
                class="mt-2 hidden w-full rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm font-medium text-green-700 md:text-base"
              >
                Form submitted successfully! You will receive the brochure on
                your phone shortly.
              </p>
            </form>

            <!-- Brochure Text -->
            <p class="text-n-700 font-secondary text-sm md:text-base">
              Our counsellors will reach out to you.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .spinner {
    width: 18px;
    height: 18px;
    border: 3px solid #f2c4c0
    border-top-color: #cc554d;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>