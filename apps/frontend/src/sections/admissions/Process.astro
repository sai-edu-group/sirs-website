---
// ADMISSION PROCESS — adapted from SIS src/sections/admission/HowItWorks.astro
// Condensed to the SIRS journey: Enquire -> Visit -> Join the family.
import SectionHeader from "@/components/ui/SectionHeader.astro";
import AdmissionStepsCard from "@/components/ui/AdmissionStepsCard.astro";

const steps = [
  {
    id: 1,
    number: "01",
    icon: "/icons/form.svg",
    title: "Enquire",
    description:
      "Your journey begins here — just a few quick details so we can guide you better.",
  },
  {
    id: 2,
    number: "02",
    icon: "/icons/campus.svg",
    title: "Visit",
    description:
      "Experience SIRS first-hand — in person or online — and see where your child will live and thrive.",
  },
  {
    id: 3,
    number: "03",
    icon: "/icons/offer-letter.svg",
    title: "Join the family",
    description:
      "Complete the application, interaction and enrolment — and we will guide you through every step, warmly and clearly.",
  },
];
---

<section id="how-to-apply" data-section="How It Works">
  <div class="container mx-auto px-6 py-16 lg:px-8 lg:py-24 2xl:px-0">
    <SectionHeader
      title="How it Works"
      subtitle="We're here to guide you every step of the way — from your first enquiry to the moment your child walks into their second home."
    />

    <div
      class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-8 xl:grid-cols-3"
    >
      {
        steps.map((step) => (
          <AdmissionStepsCard
            icon={step.icon}
            number={step.number}
            title={step.title}
            description={step.description}
          />
        ))
      }
    </div>
  </div>
</section>
