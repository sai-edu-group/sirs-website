---
import Layout from "@/layouts/Layout.astro";

// COMPONENTS //
import PageHero from "@/components/ui/PageHero.astro";
import HowItWorks from "@/sections/admissions/HowItWorks.astro";
import Form from "@/sections/admissions/Form.astro";
import FAQ from "@/sections/admissions/FAQ.astro";
---

<Layout meta={{ title: "Admissions" }}>
  <PageHero
    dataSection="Admissions Hero"
    eyebrow="Admissions"
    title="Give them a second home"
    highlight="second home"
    description="Admissions are open for Classes IV–XII. Share a few details and our counsellors will guide you through every step, warmly and clearly."
    image="/images/admission-hero.webp"
    imageAlt="A family meeting an admissions counsellor across a desk"
    frame="line"
  />
  <HowItWorks />
  <Form />
  <FAQ />
</Layout>
