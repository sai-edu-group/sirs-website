---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import FinalCTA from "@/sections/common/FinalCTA.astro";

const shows = [
  {
    title: "The Morning Bell",
    day: "Mon · Wed · Fri",
    time: "8:10 am",
    text: "Notices, birthdays, house points and the day's thought — read by the students who wrote it.",
  },
  {
    title: "Between the Lines",
    day: "Tuesday",
    time: "4:00 pm",
    text: "Book reviews, author interviews and the occasional argument about endings.",
  },
  {
    title: "Field Notes",
    day: "Thursday",
    time: "4:30 pm",
    text: "Match reports, athlete interviews and the stories behind the scoreboard.",
  },
  {
    title: "The Orange Room",
    day: "Saturday",
    time: "6:00 pm",
    text: "Student bands, playlist requests and long-form conversations with teachers.",
  },
];
---

<Layout meta={{ title: "Radio Orange" }}>
  <PageHero
    eyebrow="Radio Orange"
    title="A radio station run by students."
    highlight="run by students"
    description="Broadcast from the SIRS campus, Radio Orange is where students write, produce and present their own shows — learning to speak clearly, listen properly and hit a deadline."
    image="/images/strip-chairperson.webp"
    imageAlt="SIRS students in conversation with the Chairperson"
    imageFit="cover"
    frame="arch"
    titleSize="compact"
    dataSection="Radio Orange Page Hero"
  >
    <a
      href="#on-air"
      class="font-secondary inline-flex items-center justify-center gap-2 rounded-lg bg-orange-500 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-orange-600 md:px-8 md:py-4 md:text-base"
    >
      Listen to a Sample
      <span aria-hidden="true">&darr;</span>
    </a>
    <a
      href="/media/blogs"
      class="font-secondary inline-flex items-center justify-center gap-2 rounded-lg border border-orange-500 px-6 py-3 text-sm font-semibold text-orange-500 transition-colors hover:bg-orange-500 hover:text-white md:px-8 md:py-4 md:text-base"
    >
      Read Student Stories
    </a>
  </PageHero>

  <!-- On air -->
  <section
    id="on-air"
    class="bg-n-950 relative overflow-hidden text-white"
    data-section="Radio Orange On Air"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div
        class="absolute -top-32 right-0 size-[32rem] rounded-full bg-orange-500/20 blur-3xl"
      >
      </div>
      <div
        class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
      >
      </div>
    </div>

    <div
      class="relative container mx-auto px-6 py-16 md:py-20 lg:py-24 2xl:px-0"
    >
      <div
        class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16"
      >
        <div class="space-y-5">
          <p
            class="font-secondary flex items-center gap-3 text-xs font-semibold tracking-[0.25em] text-orange-300 uppercase md:text-sm"
          >
            <span class="relative flex size-2">
              <span
                class="absolute inline-flex size-full animate-ping rounded-full bg-orange-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex size-2 rounded-full bg-orange-400"
              ></span>
            </span>
            On air
          </p>
          <h2
            class="text-3xl leading-[1.12] font-medium md:text-4xl lg:text-5xl"
          >
            Tune in to the sound of SIRS.
          </h2>
          <p
            class="font-secondary max-w-lg text-sm leading-relaxed text-white/65 md:text-base"
          >
            Our studio sits at the edge of the academic block. Every show is
            planned, scripted and presented by students, with a faculty producer
            keeping the standards — and the schedule — honest.
          </p>

          <div class="flex flex-wrap gap-2 pt-2">
            {
              ["Student produced", "Weekly schedule", "Live on campus"].map(
                (chip) => (
                  <span class="font-secondary rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-white/75">
                    {chip}
                  </span>
                ),
              )
            }
          </div>
        </div>

        <!-- Player -->
        <div
          class="rounded-3xl border border-white/10 bg-white/[0.05] p-5 md:p-7"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <p
                class="font-secondary text-[10px] font-semibold tracking-[0.2em] text-orange-300 uppercase"
              >
                Now playing
              </p>
              <p class="mt-1.5 text-xl font-medium md:text-2xl">
                Campus Sounds
              </p>
              <p class="font-secondary mt-1 text-xs text-white/50">
                Recorded on the SIRS campus
              </p>
            </div>
            <div class="flex h-12 items-end gap-1" aria-hidden="true">
              {
                [40, 65, 30, 80, 55, 90, 45, 70].map((height) => (
                  <span
                    class="w-1 rounded-full bg-orange-400/80"
                    style={`height: ${height}%`}
                  />
                ))
              }
            </div>
          </div>

          <audio
            class="mt-6 w-full"
            controls
            preload="none"
            src="/audio/campus-sound.wav"
          >
            Your browser does not support the audio element.
          </audio>

          <div class="mt-5 border-t border-white/10 pt-4">
            <p
              class="font-secondary text-[10px] font-semibold tracking-[0.2em] text-white/40 uppercase"
            >
              Up next
            </p>
            <p class="mt-2 text-sm text-white/80">
              The Morning Bell · Monday, 8:10 am
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Shows -->
  <section class="bg-n-50" data-section="Radio Orange Shows">
    <div class="container mx-auto px-6 py-16 md:py-20 lg:py-24 2xl:px-0">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div>
          <p
            class="font-secondary flex items-center gap-3 text-xs font-semibold tracking-[0.25em] text-orange-500 uppercase md:text-sm"
          >
            <span class="size-1.5 rotate-45 bg-orange-500" aria-hidden="true"
            ></span>
            The schedule
          </p>
          <h2
            class="text-n-800 mt-3 text-3xl leading-[1.12] font-medium md:text-4xl lg:text-5xl"
          >
            Four shows. One frequency.
          </h2>
        </div>
        <p
          class="font-secondary text-n-600 max-w-sm text-sm leading-relaxed md:text-base"
        >
          Shows rotate each term. Students can pitch a new format at the start
          of every term — several have made it to air.
        </p>
      </div>

      <div class="mt-10 grid gap-3 sm:grid-cols-2">
        {
          shows.map((show, index) => (
            <article
              class="card-anim card-bottom border-n-200 rounded-3xl border bg-white p-6 md:p-7"
              style={`--delay: ${index * 0.06}s`}
            >
              <div class="flex items-start justify-between gap-4">
                <span class="font-secondary text-[11px] font-semibold tracking-[0.2em] text-orange-500/70">
                  0{index + 1}
                </span>
                <div class="font-secondary text-n-500 text-right text-[10px] font-semibold tracking-[0.12em] uppercase">
                  <p>{show.day}</p>
                  <p class="mt-1 text-orange-500">{show.time}</p>
                </div>
              </div>
              <h3 class="text-n-800 mt-3 text-xl font-medium md:text-2xl">
                {show.title}
              </h3>
              <p class="font-secondary text-n-600 mt-2 text-sm leading-relaxed">
                {show.text}
              </p>
            </article>
          ))
        }
      </div>

      <div
        class="bg-n-100 mt-8 flex flex-col gap-4 rounded-2xl p-6 md:flex-row md:items-center md:justify-between md:p-8"
      >
        <p class="text-n-800 text-lg leading-snug font-medium md:text-xl">
          Want your child behind the microphone? The studio recruits every term.
        </p>
        <a
          href="/contact-us"
          class="font-secondary inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-orange-600 transition-colors hover:text-orange-700"
        >
          Talk to the school
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <FinalCTA
    eyebrow="Admissions 2026–27"
    title="Find their voice at SIRS."
    description="Every child finds a stage here — a microphone, a field, a canvas or a council seat. Come and see where yours might stand."
    primaryLabel="Book a Campus Visit"
    primaryHref="/contact-us"
    secondaryLabel="Start an Application"
    secondaryHref="/admissions"
  />
</Layout>
