---
import Layout from "@/layouts/Layout.astro";
import Article from "@/components/ui/Article.astro";
import SectionHeaderMain from "@/components/ui/SectionHeaderMain.astro";

// DATA
import { blogDetails } from "@/data/media/blogs/[slug]";

// UTILS
import { generateImagePath } from "@/utils/image.utils";
import { IMAGE_TYPES } from "@/enums/image.enum";

const { title, content, thumbnail, created_on } = blogDetails;
---

<Layout>
  <section class="ns-slider" id="blog-single" data-section="Blog Single">
    <div
      class="container mx-auto px-6 py-14 md:py-20 lg:px-8 2xl:px-0"
    >
      <div class="max-w-2xl mx-auto">
        <Article
          title={title}
          content={content}
          eyebrowText=""
        >
          <Image
            src={generateImagePath(
              thumbnail,
              IMAGE_TYPES.BLOG,
            )}
            alt={title}
            class="card-anim card-bottom h-[300px] w-full rounded-3xl object-cover md:h-[400px] lg:h-[500px]"
            width={1200}
            height={400}
            style={`--delay: 0.1s`}
          />
        </Article>
      </div>
    </div>
  </section>
</Layout>
