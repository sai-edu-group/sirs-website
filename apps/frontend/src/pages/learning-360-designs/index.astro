  }

  <!-- FOOTER NOTE -->
  <section class="border-t border-n-200 bg-white">
    <div class="container m-auto flex flex-col gap-1.5 px-5 py-7 md:py-9">
      <p class="text-n-800 text-base font-medium md:text-lg">
        Pick one - Option 01 to 11.
      </p>
      <p class="font-secondary text-n-500 max-w-2xl text-[13px] leading-relaxed md:text-sm">
        Temporary page. The chosen layout gets ported into{" "}
        <span class="text-n-700 font-semibold"
          >src/sections/home/Learning360.astro</span
        > and this page is removed.
      </p>
    </div>
  </section>
  <script>
    // Auto-switch: cycle the three Learning @ 360 pillars
    document.querySelectorAll("[data-l360-widget]").forEach((widget) => {
      const slides = [...widget.querySelectorAll("[data-l360-slide]")];
      const dots = [...widget.querySelectorAll("[data-l360-dot]")];
      const rows = [...widget.querySelectorAll("[data-l360-row]")];
      if (slides.length < 2) return;

      const INTERVAL = 4000;
      let current = 0;
      let timer = null;

      const show = (next) => {
        current = (next + slides.length) % slides.length;

        slides.forEach((slide, i) => {
          const active = i === current;
          slide.classList.toggle("opacity-100", active);
          slide.classList.toggle("opacity-0", !active);
          slide.setAttribute("aria-hidden", active ? "false" : "true");
        });

        dots.forEach((dot, i) => {
          const active = i === current;
          dot.classList.toggle("w-6", active);
          dot.classList.toggle("bg-white", active);
          dot.classList.toggle("w-1.5", !active);
          dot.classList.toggle("bg-white/50", !active);
        });

        rows.forEach((row, i) => {
          const active = i === current;
          row.style.backgroundColor = active ? row.dataset.soft : "";
          const title = row.querySelector("[data-l360-title]");
          if (title) {
            title.style.color = active ? row.dataset.accent : "";
          }
        });
      };

      const start = () => {
        stop();
        timer = window.setInterval(() => show(current + 1), INTERVAL);
      };

      function stop() {
        if (timer) {
          window.clearInterval(timer);
          timer = null;
        }
      }

      // Pause on hover so readers can dwell on a pillar
      widget.addEventListener("mouseenter", stop);
      widget.addEventListener("mouseleave", start);

      // Click a row to jump to its pillar
      rows.forEach((row, i) => {
        row.style.cursor = "pointer";
        row.addEventListener("click", () => {
          show(i);
          start();
        });
      });

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      show(0);
      if (!reduce.matches) start();
      reduce.addEventListener("change", (e) => {
        if (e.matches) stop();
        else start();
      });
    });
  </script>
</Layout>
