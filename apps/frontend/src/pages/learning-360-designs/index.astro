                      ]}
                    >
                      <div class="flex flex-col gap-5 lg:flex-row">
                        <div
                          class="h-[224px] w-full shrink-0 overflow-hidden md:h-[240px] lg:h-[250px] lg:w-[45%] lg:max-w-[250px]"
