                </article>

                <!-- Rails: Create + Move -->
                <div
                  class="flex flex-col md:col-span-12 md:grid md:grid-cols-2 md:gap-8 lg:col-span-6 lg:flex lg:flex-col lg:gap-0 lg:pt-10 xl:col-span-5"
                >
                  {railPillars.map((pillar, railIndex) => (
                    <article
