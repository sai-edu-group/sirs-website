---
// TEMPORARY REVIEW PAGE - five design options for the Learning @ 360 section.
// Pick one and it gets ported into sections/home/Learning360.astro.

import Layout from "@/layouts/Layout.astro";
import {
  learning360Header,
  learningPillars,
} from "@/data/home/learning-360";

const pillarImages = [
  { src: "/images/about-hero.webp", alt: "Students in a smart classroom" },
  { src: "/images/activities.jpg", alt: "Students performing a group dance" },
  {
    src: "/images/sports-facilities (1).jpg",
    alt: "The SIRS athletics stadium",
  },
];

const accents = {
  orange: {
    dot: "bg-orange-500",
    chip: "bg-orange-50 text-orange-700",
    text: "text-orange-600",
    soft: "bg-orange-50",
    border: "border-orange-300",
    solid: "bg-orange-500",
    darkChip: "bg-orange-500/15 text-orange-300",
  },
  violet: {
    dot: "bg-violet-500",
    chip: "bg-violet-50 text-violet-600",
    text: "text-violet-600",
    soft: "bg-violet-50",
    border: "border-violet-300",
    solid: "bg-violet-500",
    darkChip: "bg-violet-500/20 text-violet-200",
  },
  slate: {
    dot: "bg-n-700",
    chip: "bg-n-100 text-n-700",
    text: "text-n-700",
    soft: "bg-n-100",
    border: "border-n-300",
    solid: "bg-n-800",
    darkChip: "bg-white/10 text-n-200",
  },
} as const;

const options = [
  {
    id: "option-1",
    num: "01",
    name: "Alternating Split Rows",
    note: "Photo and text swap sides, one row per pillar.",
  },
  {
    id: "option-2",
    num: "02",
    name: "Photo Cards",
    note: "Three cards, photo header on top of each.",
  },
  {
    id: "option-3",
    num: "03",
    name: "Photo + Topic Panel",
    note: "One tall photo beside a clean topic panel.",
  },
  {
    id: "option-4",
    num: "04",
    name: "Dark Feature Band",
    note: "Contrast band, photo thumbnail per pillar.",
  },
  {
    id: "option-5",
    num: "05",
    name: "Photo + Overlapping Card",
    note: "Wide photo with the topics card overlapping it.",
  },
  {
    id: "option-6",
    num: "06",
    name: "Triptych - All Three at Once",
  },
  {
    id: "option-9",
    num: "07",
    name: "Centered Image Cards",
    note: "Equal image cards with tagline chip overlay.",
  },
  {
    id: "option-10",
    num: "08",
    name: "Bottom Overlay Cards",
    note: "Image cards with tagline + title overlay at bottom.",
  },
  {
    id: "option-11",
    num: "09",
    name: "Full Image Cards",
    note: "Each card is the image itself with centered text overlay.",
  },
];
---

<Layout
  meta={{
    title: "Learning 360 - Design Options",
    description:
      "Eleven design options for the Learning @ 360 section - internal review page.",
  }}
>
  <!-- PAGE INTRO -->
  <section class="bg-n-50 w-full">
    <div
      class="container m-auto flex flex-col gap-3 px-5 pt-32 pb-7 md:pt-40 md:pb-9"
    >
      <p
        class="font-secondary text-orange-600 text-[11px] font-semibold tracking-[0.24em] uppercase md:text-xs"
      >
        Temporary review page
      </p>
      <h1
        class="text-n-800 text-3xl leading-[1.15] font-medium tracking-tight md:text-4xl"
      >
        Learning @ 360 - design options
      </h1>
      <p class="font-secondary text-n-600 max-w-2xl text-sm leading-relaxed md:text-base">
        Nine compact layouts for the section. Main topics and images side by
        side - shortlist one and it gets built.
      </p>

      <nav class="flex flex-wrap gap-2 pt-1">
        {
          options.map((option) => (
            <a
              href={`#${option.id}`}
              class="font-secondary border-n-200 text-n-600 hover:border-orange-400 hover:text-orange-600 hover:bg-orange-50 rounded-full border bg-white px-3.5 py-1.5 text-xs font-medium transition-all md:text-[13px]"
            >
              <span class="text-orange-500">{option.num}</span>
              <span class="px-1.5 text-n-300">/</span>
              {option.name}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    options.map((option, optionIndex) => (
      <section
        id={option.id}
        class="w-full scroll-mt-24 border-t border-n-200"
      >
        <!-- Option label -->
        <div class="bg-white">
          <div class="container m-auto flex flex-col gap-1 px-5 py-4 md:flex-row md:items-center md:justify-between md:py-5">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <p class="font-secondary text-orange-600 text-[11px] font-semibold tracking-[0.24em] uppercase">
                Option {option.num}
              </p>
              <h2 class="text-n-800 text-lg font-medium tracking-tight md:text-xl">
                {option.name}
              </h2>
            </div>
            <p class="font-secondary text-n-500 text-[13px] md:text-sm">
              {option.note}
            </p>
          </div>
        </div>

        <!-- ============================================================
             OPTION 1 - ALTERNATING SPLIT ROWS
             ============================================================ -->
        {optionIndex === 0 && (
          <div class="bg-n-100">
            <div class="container m-auto px-5 py-6 md:py-8 lg:px-8 2xl:px-0">
              <div class="flex flex-col gap-4">
                {learningPillars.map((pillar, index) => (
                  <article
                    class:list={[
                      "bg-white border-n-200 grid items-center gap-5 rounded-2xl border p-3.5 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-shadow duration-300 hover:shadow-[0_8px_24px_rgba(15,23,42,0.07)] md:gap-6 md:p-4",
                      index % 2 === 1
                        ? "md:grid-cols-[minmax(0,1fr)_minmax(0,300px)]"
                        : "md:grid-cols-[minmax(0,300px)_minmax(0,1fr)]",
                    ]}
                  >
                    <div
                      class:list={[
                        "relative overflow-hidden rounded-xl",
                        index % 2 === 1 && "md:order-2",
                      ]}
                    >
                      <img
                        src={pillarImages[index].src}
                        alt={pillarImages[index].alt}
                        class="h-36 w-full object-cover md:h-44"
                        loading="lazy"
                        decoding="async"
                      />
                      <span
                        class:list={[
                          "font-secondary absolute top-2.5 left-2.5 rounded-full px-2.5 py-1 text-[10px] font-semibold tracking-[0.16em] text-white uppercase",
                          accents[pillar.accent].solid,
                        ]}
                      >
                        {pillar.tagline}
                      </span>
                    </div>

                    <div class="flex flex-col gap-2.5">
                      <div class="flex flex-wrap items-center gap-2.5">
                        <span
                          class:list={[
                            "font-secondary flex size-8 shrink-0 items-center justify-center rounded-full border-2 text-xs font-semibold",
                            accents[pillar.accent].chip,
                            accents[pillar.accent].border,
                          ]}
                        >
                        </span>
                        <h3 class="text-n-800 text-lg font-medium tracking-tight md:text-xl">
                          {pillar.title}
                        </h3>
                      </div>

                      <p class="font-secondary text-n-500 max-w-3xl text-[13px] leading-relaxed md:text-sm">
                        {pillar.lead}
                      </p>

                      <div class="grid grid-cols-1 gap-x-6 gap-y-1.5 sm:grid-cols-2">
                        {pillar.items.map((item) => (
                          <p class="font-secondary flex gap-2 text-[13px] leading-snug">
                            <span
                              class:list={[
                                "mt-1.5 size-1.5 shrink-0 rounded-full",
                                accents[pillar.accent].dot,
                              ]}
                              aria-hidden="true"
                            />
                            <span class="text-n-700 font-semibold">
                              {item.title}
                            </span>
                            <span class="text-n-500">{item.description}</span>
                          </p>
                        ))}
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        )}

        <!-- ============================================================
             OPTION 2 - PHOTO CARDS
             ============================================================ -->
        {optionIndex === 1 && (
          <div class="bg-n-100">
            <div class="container m-auto px-5 py-6 md:py-8 lg:px-8 2xl:px-0">
              <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
                {learningPillars.map((pillar, index) => (
                  <article class="bg-white border-n-200 group flex flex-col overflow-hidden rounded-2xl border shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_28px_rgba(15,23,42,0.09)]">
                    <div class="relative h-32 overflow-hidden md:h-36">
                      <img
                        src={pillarImages[index].src}
                        alt={pillarImages[index].alt}
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                      <span
                        class:list={[
                          "font-secondary absolute bottom-2.5 left-2.5 rounded-full px-2.5 py-1 text-[10px] font-semibold tracking-[0.16em] uppercase",
                          accents[pillar.accent].chip,
                        ]}
                      >
                        {pillar.tagline}
                      </span>
                    </div>

                    <div class="flex flex-1 flex-col gap-2.5 p-4 md:p-5">
                      <div class="flex items-center gap-2.5">
                        <span
                          class:list={[
                            "font-secondary flex size-7 shrink-0 items-center justify-center rounded-lg text-[11px] font-semibold",
                            accents[pillar.accent].soft,
                            accents[pillar.accent].text,
                          ]}
                        >
                        </span>
                        <h3 class="text-n-800 text-base font-medium tracking-tight md:text-lg">
                          {pillar.title}
                        </h3>
                      </div>

                      <p class="font-secondary text-n-500 text-[13px] leading-relaxed">
                        {pillar.lead}
                      </p>

                      <div class="border-n-100 mt-auto flex flex-col border-t pt-1">
                        {pillar.items.map((item, itemIndex) => (
                          <p
                            class:list={[
                              "font-secondary flex gap-2 py-1.5 text-[13px] leading-snug",
                              itemIndex > 0 && "border-n-100 border-t",
                            ]}
                          >
                            <span class="text-n-700 font-semibold">
                              {item.title}
                            </span>
                            <span class="text-n-500">{item.description}</span>
                          </p>
                        ))}
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        )}

        <!-- ============================================================
             OPTION 3 - STACKED ROWS
             ============================================================ -->
        {optionIndex === 2 && (
          <div class="bg-white">
            <div class="container m-auto px-5 py-6 md:py-8 lg:px-8 2xl:px-0">
              <div class="flex flex-col items-center gap-4 md:gap-6">
                <p class="font-secondary text-orange-600 text-[11px] font-semibold tracking-[0.24em] uppercase md:text-xs">
                  {learning360Header.eyebrow}
                </p>
                <h2 class="text-n-800 text-2xl font-medium tracking-tight text-center md:text-3xl">
                  {learning360Header.titleLead}{" "}
                  <span class="text-orange-500">{learning360Header.titleHighlight}</span>{" "}
                  {learning360Header.titleTail}
                </h2>
                <p class="font-secondary text-n-600 text-[13px] leading-relaxed md:text-sm max-w-2xl text-center">
                  {learning360Header.subtitle}
                </p>
              </div>
              <div class="flex flex-col gap-3 pt-4">
                {learningPillars.map((pillar, index) => (
                  <article
                    class:list={[
                      "flex items-center gap-6 rounded-2xl border border-n-100 p-4 md:p-6 shadow-sm transition-all duration-300 hover:bg-n-50 hover:shadow-md",
                      index % 2 === 0 && "bg-n-50",
                    ]}
                  >
                    <!-- Image left -->
                    <div class="relative shrink-0 size-24 md:size-32 rounded-xl overflow-hidden border border-n-200 bg-n-200">
                      <img
                        src={pillarImages[index].src}
                        alt={pillarImages[index].alt}
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="absolute top-2 left-2 font-secondary size-4 shrink-0 items-center justify-center rounded-full border border-n-200 bg-white text-[9px] font-semibold">
                      </span>
                    </div>

                    <!-- Text right -->
                    <div class="flex flex-col gap-2 flex-1 min-w-0">
                      <div class="flex items-center gap-2.5">
                        <h3 class="text-n-800 text-base font-medium tracking-tight md:text-lg">
                          {pillar.title}
                        </h3>
                        <span
                          class:list={[
                            "font-secondary rounded-full px-2 py-0.5 text-[9px] font-semibold tracking-[0.16em] uppercase",
                            pillar.accent === "orange" && "bg-orange-50 text-orange-700",
                            pillar.accent === "violet" && "bg-violet-50 text-violet-700",
                            pillar.accent === "slate" && "bg-n-100 text-n-700",
                          ]}
                        >
                          {pillar.tagline}
                        </span>
                      </div>
                      <p class="font-secondary text-n-500 text-[13px] leading-relaxed md:text-sm">
                        {pillar.lead}
                      </p>
                      <ul class="flex flex-wrap gap-1.5 mt-2">
                        {pillar.items.map((item) => (
                          <span class="font-secondary rounded-md bg-n-100 px-2 py-1 text-[11px] text-n-600">
                            {item.title}
                          </span>
                        ))}
                      </ul>
                    </div>
                  </article>
                ))}
              </div>
              <p class="font-secondary text-n-500 mt-6 text-center text-[13px] md:text-sm">
                {learning360Header.noteCaption}
              </p>
            </div>
          </div>
        )}

        <!-- ============================================================
             OPTION 4 - CIRCULAR MINIMAL
             ============================================================ -->
        {optionIndex === 3 && (
          <div class="bg-n-50">
            <div class="container m-auto px-5 py-6 md:py-10 lg:px-8 2xl:px-0">
              <div class="flex flex-col items-center gap-4 md:gap-8 text-center">
                <p class="font-secondary text-orange-600 text-[11px] font-semibold tracking-[0.24em] uppercase md:text-xs">
                  {learning360Header.eyebrow}
                </p>
                <h2 class="text-n-800 text-2xl font-medium tracking-tight md:text-4xl">
                  {learning360Header.titleLead}{" "}
                  <span class="text-orange-500">{learning360Header.titleHighlight}</span>{" "}
                  {learning360Header.titleTail}
                </h2>
                <p class="font-secondary text-n-600 text-[13px] leading-relaxed md:text-sm max-w-2xl">
                  {learning360Header.subtitle}
                </p>
              </div>
              <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-10 pt-8">
                {learningPillars.map((pillar, index) => (
                  <article class="flex flex-col items-center gap-4 p-4 md:p-6 rounded-2xl border border-n-100 bg-white shadow-sm hover:shadow-md transition-all duration-300">
                    <div class="relative size-36 md:size-48 shrink-0 rounded-full overflow-hidden border border-n-200 shadow-sm">
                      <img
                        src={pillarImages[index].src}
                        alt={pillarImages[index].alt}
                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="absolute -bottom-2 -right-2 font-secondary size-5 shrink-0 items-center justify-center rounded-full border border-white bg-n-50 text-[10px] font-semibold">
                      </span>
                    </div>
                    <h3 class="text-n-800 text-base font-medium tracking-tight md:text-lg">
                      {pillar.title}
                    </h3>
                    <span
                      class:list={[
                        "font-secondary rounded-full px-2 py-0.5 text-[9px] font-semibold tracking-[0.16em] uppercase",
                        pillar.accent === "orange" && "bg-orange-50 text-orange-700",
                        pillar.accent === "violet" && "bg-violet-50 text-violet-700",
                        pillar.accent === "slate" && "bg-n-100 text-n-700",
                      ]}
                    >
                      {pillar.tagline}
                    </span>
                    <div class="flex flex-wrap justify-center gap-1.5 mt-3">
                      {pillar.items.map((item) => (
                        <span class="font-secondary rounded-md bg-n-100 px-2 py-1 text-[11px] text-n-600">
                          {item.title}
                        </span>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
              <p class="font-secondary text-n-500 mt-6 text-center text-[13px] md:text-sm">
                {learning360Header.noteCaption}
              </p>
            </div>
          </div>
        )}

        <!-- ============================================================
             OPTION 5 - PHOTO + OVERLAPPING CARD
             ============================================================ -->
        {optionIndex === 4 && (
          <div class="bg-n-100">
            <div class="container m-auto px-5 py-6 md:py-8 lg:px-8 2xl:px-0">
              <div class="grid grid-cols-1 items-center lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
                <!-- Photo -->
                <div class="overflow-hidden rounded-2xl">
                  <img
                    src="/images/strip-stadium.webp"
                    alt="SIRS campus life"
                    class="h-44 w-full object-cover md:h-60 lg:h-[400px]"
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <!-- Overlapping card -->
                <div
                  class="bg-white border-n-200 relative z-10 mx-3 -mt-10 rounded-2xl border p-4 shadow-[0_12px_32px_rgba(15,23,42,0.12)] md:p-5 lg:mx-0 lg:-ml-16 lg:mt-0"
                >
                  <div class="flex flex-col gap-1.5">
                    <p class="font-secondary text-orange-600 text-[11px] font-semibold tracking-[0.24em] uppercase">
                      {learning360Header.eyebrow}
                    </p>
                    <h3 class="text-n-800 text-lg font-medium tracking-tight md:text-xl">
                      {learning360Header.titleLead}{" "}
                      <span class="text-orange-500">
                        {learning360Header.titleHighlight}
                      </span>{" "}
                      {learning360Header.titleTail}
                    </h3>
                    <p class="font-secondary text-n-500 text-[13px] leading-relaxed">
                      {learning360Header.subtitle}
                    </p>
                  </div>

                  <div class="border-n-100 mt-4 flex flex-col divide-y divide-n-100 border-t">
                    {learningPillars.map((pillar, index) => (
                      <div class="flex items-center gap-3 py-2.5">
                        <img
                          src={pillarImages[index].src}
                          alt={pillarImages[index].alt}
                          class="size-12 shrink-0 rounded-lg object-cover md:size-14"
                          loading="lazy"
                          decoding="async"
                        />
                        <div class="flex min-w-0 flex-col gap-0.5">
                          <div class="flex flex-wrap items-center gap-2">
                            <h4 class="text-n-800 text-sm font-medium md:text-base">
                              {pillar.title}
                            </h4>
                            <span
                              class:list={[
                                "font-secondary rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-[0.16em] uppercase",
                                accents[pillar.accent].chip,
                              ]}
                            >
                              {pillar.tagline}
                            </span>
                          </div>
                          <p class="font-secondary text-n-500 line-clamp-2 text-[13px]">
                            {pillar.items
                              .map((item) => item.title)
                              .join("  ·  ")}
                          </p>
                        </div>
                      </div>
                    ))}
                  </div>

                  <a
                    href="/sirs-experience/learning-360"
                    class="font-secondary group mt-4 inline-flex w-fit items-center gap-2 rounded-lg bg-orange-500 px-4 py-2.5 text-[13px] font-semibold text-white transition-colors hover:bg-orange-600"
                  >
                    Explore Learning @ 360
                    <span
                      class="transition-transform duration-300 group-hover:translate-x-1"
                      aria-hidden="true">&rarr;</span
                    >
                  </a>
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- ============================================================
             OPTION 6 - TRIPTYCH - ALL THREE AT ONCE
             ============================================================ -->
        {optionIndex === 5 && (
          <div class="bg-n-100">
            <div class="container m-auto px-5 py-6 md:py-8 lg:px-8 2xl:px-0">
              <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
                {learningPillars.map((pillar, index) => (
                  <article class="group relative overflow-hidden rounded-2xl">
                    <img
                      src={pillarImages[index].src}
                      alt={pillarImages[index].alt}
                      class="h-56 w-full object-cover transition-transform duration-700 group-hover:scale-105 md:h-72"
                      loading="lazy"
                      decoding="async"
                    />
                    <div
                      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/35 to-transparent"
                      aria-hidden="true"
                    />
                    <span
                      class="font-secondary absolute top-3 left-3 flex size-8 items-center justify-center rounded-lg bg-white/95 text-xs font-semibold text-n-800"
                    >
                    </span>

                    <div class="absolute inset-x-0 bottom-0 flex flex-col gap-2 p-4 md:p-5">
                      <span
                        class:list={[
                          "font-secondary w-fit rounded-full px-2.5 py-1 text-[10px] font-semibold tracking-[0.16em] uppercase",
                          pillar.accent === "orange" &&
                            "bg-orange-500/90 text-white",
                          pillar.accent === "violet" &&
                            "bg-violet-500/90 text-white",
                          pillar.accent === "slate" &&
                            "bg-white/90 text-n-800",
                        ]}
                      >
                        {pillar.tagline}
                      </span>
                      <h3 class="text-lg font-medium tracking-tight text-white md:text-xl">
                        {pillar.title}
                      </h3>
                      <div class="flex flex-wrap gap-1.5">
                        {pillar.items.map((item) => (
                          <span class="font-secondary rounded-md bg-white/15 px-2 py-1 text-[11px] text-white/90 backdrop-blur-sm">
                            {item.title}
                          </span>
                        ))}
                      </div>
                    </div>
                  </article>
                ))}
              </div>

              <p class="font-secondary text-n-500 mt-5 text-center text-[13px] md:text-sm">
                {learning360Header.note} - {learning360Header.noteCaption}
              </p>
            </div>
          </div>
        )}
        <!-- ============================================================
        <!-- ============================================================
             OPTION 7 - SPLIT SCREEN CARDS
             ============================================================ -->
        {optionIndex === 6 && (
          <div class="bg-n-50">
            <div class="container m-auto px-5 py-6 md:py-10 lg:px-8 2xl:px-0">
              <div class="flex flex-col items-center gap-4 md:gap-6">
                <p class="font-secondary text-orange-600 text-[11px] font-semibold tracking-[0.24em] uppercase md:text-xs">
                  {learning360Header.eyebrow}
                </p>
                <h2 class="text-n-800 text-2xl font-medium tracking-tight text-center md:text-3xl">
                  {learning360Header.titleLead}{" "}
                  <span class="text-orange-500">{learning360Header.titleHighlight}</span>{" "}
                  {learning360Header.titleTail}
                </h2>
              </div>
              <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-10">
                {learningPillars.map((pillar, index) => (
                  <article class="group relative overflow-hidden rounded-2xl border border-n-200 bg-white shadow-sm hover:shadow-lg transition-all duration-300">
                    <div class="grid grid-cols-1 md:grid-cols-2">
                      <!-- Image side -->
